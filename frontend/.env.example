# Frontend environment — copy this file to `frontend/.env` for local development.
# On Vercel these are set under Settings -> Environment Variables.

# ---------------------------------------------------------------------------
# VITE_SITE_URL  (REQUIRED — the build fails without it)
# ---------------------------------------------------------------------------
# This site's own public origin, with the scheme and no trailing slash.
#
# It is the SINGLE SOURCE OF TRUTH for every absolute URL the site emits:
# canonical tags, Open Graph and Twitter tags, sitemap.xml, robots.txt, the
# OpenGraph card's footer, and (from Wave 2) every JSON-LD @id and url field.
#
# Nothing in the codebase may hardcode the domain. When the custom domain is
# purchased, changing this one value and redeploying is the entire migration:
#   1. Vercel -> Settings -> Environment Variables -> update VITE_SITE_URL
#      for Production, Preview AND Development
#   2. Redeploy without the build cache
# (The backend has two matching values — see the CORS_ALLOWED_ORIGIN and
#  APP_FRONTEND_URL entries in render.yaml.)
#
# Validation: must be an absolute http(s) URL. https is required unless the
# host is localhost. See frontend/src/lib/site-url.ts.
VITE_SITE_URL=https://jadhavomkar.vercel.app

# ---------------------------------------------------------------------------
# VITE_API_URL  (optional)
# ---------------------------------------------------------------------------
# Base URL of the Spring Boot backend.
# Leave EMPTY for local development: relative paths then go through the Vite
# dev proxy (see vite.config.ts), which keeps the browser same-origin and
# avoids CORS entirely.
# In production this must be the absolute backend origin, because the frontend
# (Vercel) and backend (Render) are different origins.
VITE_API_URL=
